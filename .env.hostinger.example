# ==============================================================================
# إعدادات بيئة الإنتاج على استضافة هوستنجر (Hostinger Production Environment)
# ==============================================================================
# انسخ محتويات هذا الملف إلى ملف (.env) على السيرفر في هوستنجر بعد تعديل البيانات
# ==============================================================================

APP_NAME="نظام إدارة العيادات والمراكز الطبية"
APP_ENV=production
APP_KEY=base64:QOzXxMJLjsqp7YK4BHXTO6/jhJz5Vgx7DcAFH5pLALc=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# ==============================================================================
# إعدادات قاعدة بيانات MySQL في هوستنجر (Hostinger MySQL Database)
# أنشئ قاعدة البيانات من: hPanel -> Databases -> Management
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_clinic
DB_USERNAME=u123456789_clinic_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# ==============================================================================
# إعدادات الجلسات والتخزين المؤقت في الإنتاج
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ==============================================================================
# إعدادات ربط خدمة الواتساب (WhatsApp Gateway Microservice)
# ==============================================================================
# 1) إذا كانت الخدمة تعمل على نفس السيرفر أو VPS:
# WHATSAPP_LOCAL_URL=http://127.0.0.1:3000
#
# 2) إذا تم تشغيلها على نطاق فرعي في هوستنجر (Cloud Startup Node.js):
# WHATSAPP_LOCAL_URL=https://wa.yourdomain.com
#
# 3) إذا تم تشغيلها على خادم سحابي مجاني (Render / Railway):
# WHATSAPP_LOCAL_URL=https://your-clinic-wa.onrender.com
WHATSAPP_LOCAL_URL=https://white-snake-453867.hostingersite.com

# ==============================================================================
# إعدادات البريد الإلكتروني (اختياري - Hostinger Titan Mail أو SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=YourEmailPassword
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="مركز العيادات التخصصية"

# ==============================================================================
# إعدادات السجلات
# ==============================================================================
LOG_CHANNEL=daily
LOG_LEVEL=error
