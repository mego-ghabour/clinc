<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive hidden files like .env
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Forward all traffic to the public directory
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
